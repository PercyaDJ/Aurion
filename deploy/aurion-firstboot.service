[Unit]
Description=Aurion : installation au premier démarrage
ConditionPathExists=/usr/lib/aurion/firstboot-pending
# No systemd-udev-settle (deprecated, slow): mount-usb waits for the key itself
After=local-fs.target userconfig.service NetworkManager.service

[Service]
Type=oneshot
ExecStart=/bin/bash /usr/lib/aurion/aurion-firstboot.sh
RemainAfterExit=yes
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
